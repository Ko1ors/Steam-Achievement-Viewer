{
  "executable": "Sav.WebApp",
  "splashscreen": {
    "imageFile": ""
  },
  "name": "Sav.WebApp",
  "description": "Keep track of your Steam achievement progress.",
  "author": "Ko1ors",
  "singleInstance": false,
  "environment": "Production",
  "build": {
    "appId": "com.ko1ors.steamachievementviewer",
    "productName": "Steam Achievement Viewer",
    "copyright": "Copyright © 2026 Ko1ors",
    "buildVersion": "2.0.0-alpha.1",
    "compression": "maximum",
    "win": {
      "target": [ "dir" ],
      "icon": "../../../../Sav.Frontend/public/favicon.ico"
    },
    "directories": {
      "output": "../../../bin/Desktop"
    },
    "extraResources": [
      {
        "from": "./bin",
        "to": "bin",
        "filter": [ "**/*" ]
      }
    ],
    "files": [
      {
        "from": "./ElectronHostHook/node_modules",
        "to": "ElectronHostHook/node_modules",
        "filter": [ "**/*" ]
      },
      "**/*",
      "!bin/**"
    ]
  }
}